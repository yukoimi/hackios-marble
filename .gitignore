# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones, files of iOS and the hackios-xnu-userland checkout (common/setup.sh), none of which belongs
# in this repository. Nothing is tracked unless it is named here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/common/
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/xnu/
!/xnu-deps/
!/uefi/
!/prebuilt/
!/wifi/

__pycache__/
*~
*.orig
*.rej

# hackios-xnu-userland's files share this working tree (common/setup.sh)
/docs/air.md
/docs/air-report.md
/prebuilt/userland/
/tools/apfs/
/tools/air/
/tools/mesa/
/tools/metal/
/tools/mk-mesa.sh
/tools/mk-jb.sh
/tools/jb-preinstall.py
/tools/font_trim.py
/tools/metallib.py

/xnuloader/*
!/xnuloader/vendor/
!/xnuloader/vendor/sha256/
!/xnuloader/vendor/sha256/sha256.c
!/xnuloader/vendor/sha256/sha256.h
!/xnuloader/vendor/sha256/README.md
!/xnuloader/vendor/lz4/
!/xnuloader/vendor/lz4/lz4.c
!/xnuloader/vendor/lz4/lz4.h
!/xnuloader/vendor/lz4/lz4hc.c
!/xnuloader/vendor/lz4/lz4hc.h
!/xnuloader/vendor/lz4/LICENSE
!/xnuloader/vendor/lz4/source.json
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/identity.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py
!/xnuloader/marble_policy.h
!/xnuloader/marble_touch.h
!/xnuloader/marble_touch_mailbox.h
!/xnuloader/marble_thermal.h
!/xnuloader/marble_cpucap.h
!/xnuloader/marble_efi_idle.h
!/xnuloader/marble_thermal_window.h
!/xnuloader/marble_vblank.h

/qemu/*
!/qemu/*.sh
!/qemu/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize

!/xnuloader/marble_display_fw.h
!/xnuloader/marble_display_clock.h
!/xnu/files/iokit/Kernel/MarbleDisplayPhase.h

# Marble daily-function sources must be part of recovery archives.
!/xnuloader/marble_*.h
!/xnuloader/marble_efi_chain.c
!/xnuloader/marble_buttons_fw.h
!/xnuloader/marble_button_debounce.h
!/xnuloader/marble_daily_fw.h
!/xnuloader/marble_pil_fw.h
!/xnuloader/marble_pil_ramfs.h
!/xnuloader/marble_smem.h
!/xnuloader/marble_scanout.h
!/xnuloader/marble_glink_fw.h
!/xnuloader/marble_smp2p.h
!/xnuloader/marble_smp2p_fw.h
!/xnuloader/marble_dsi.h
!/xnuloader/marble_brightness_mailbox.h
!/xnuloader/marble_brightness_fw.h

# Integrated, pinned userland source; do not fetch another working tree over it.
!/README.upstream.md
!/NOTICE.md
!/.gitattributes
!/.github/
!/reference/
!/userland/
!/ios165/
/ios165/*
!/ios165/*.py
!/ios165/*.sh
!/tools/apfs/
!/tools/air/
!/tools/mesa/
!/tools/metal/
!/tools/mk-mesa.sh
!/tools/mk-jb.sh
!/tools/jb-preinstall.py
!/tools/font_trim.py
!/tools/metallib.py
!/docs/air.md
!/docs/air-report.md
!/xnuloader/vendor/lzma/
!/xnuloader/vendor/lzma/*
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
*.apfs
*.dmg
*.img
*.vmdk
*.qcow2
*.vmem
*.bin
*.exe
*.obj
*.o
*.log
!/tools/tests/fixtures/*.log

!/xnuloader/loader_result.h

# APFS inspection launch commands are text source, not a filesystem image.
!/userland/rc.jobs.apfs
